{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "dev-no-node",
      "runtimeExecutable": "node_modules/electron/dist/electron.exe",
      "runtimeArgs": ["node_modules/vite/bin/vite.js"],
      "env": { "ELECTRON_RUN_AS_NODE": "1" },
      "port": 5173
    },
    {
      "name": "preview",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "vite",
        "preview",
        "--port",
        "4173",
        "--strictPort"
      ],
      "port": 4173
    }
  ]
}
