# Desktop build outputs
dist-electron/
release/

# The EFT log-watcher source lives in electron/logs (not log output)
!electron/logs/

# Machine-specific notes, secrets and signing material: never commit
CLAUDE.local.md
.env
.env.*
*.pem
*.pfx
*.p12
*.key

# Stash scanner fingerprints (generated: npm run scan:fingerprints)
public/scan/

# Offline text reader for the stash scanner (generated: npm run ocr:assets)
public/ocr/

# Tesseract model downloaded by older OCR test runs (the app ships public/ocr)
/eng.traineddata

# Content packs (npm run packs): uploaded with each release, never committed
/release-packs/
/electron/packs.generated.json
